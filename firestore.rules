rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isContributor() {
      return isSignedIn() &&
        (request.auth.token.contributor == true || request.auth.token.admin == true);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isApproved(data) {
      return data.status == 'approved';
    }

    // ── wallpapers ────────────────────────────────────────────────────────────
    match /wallpapers/{wallpaperId} {

      // PUBLIC: Anyone can read APPROVED wallpapers only
      allow read: if isApproved(resource.data);

      // CONTRIBUTOR: Can create their own wallpaper (starts as pending)
      allow create: if isContributor()
        && request.resource.data.contributorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
             'title', 'category', 'cloudinaryPublicId',
             'imageUrl', 'thumbUrl', 'width', 'height', 'size',
             'contributorId', 'contributorName', 'createdAt'
           ]);

      // CONTRIBUTOR: Can edit their own PENDING wallpaper only
      allow update: if isOwner(resource.data.contributorId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['contributorId', 'status', 'stats']);

      // ADMIN: Full access to wallpapers (approve/reject/edit stats)
      allow read, write: if isAdmin();

      // Nobody (even admin) can hard delete — use status = rejected
    }

    // ── categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;              // Public
      allow write: if isAdmin();
    }

    // ── featured ─────────────────────────────────────────────────────────────
    match /featured/{featuredId} {
      allow read: if true;              // Public
      allow write: if isAdmin();
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read/update their own profile
      allow read, update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'status', 'payoutInfo']);

      // Only admin can create/modify user role, status, payoutInfo
      allow read, write: if isAdmin();

      // Contributors can read other contributor profiles (public name)
      allow read: if isContributor();
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Anyone can create a report
      allow create: if true
        && request.resource.data.keys().hasAll(['wallpaperId', 'reason', 'createdAt']);

      // Only admin can read/update reports
      allow read, update: if isAdmin();
    }

    // ── dailyStats ────────────────────────────────────────────────────────────
    match /dailyStats/{date} {
      allow read, write: if isAdmin();
    }

    // ── earnings ──────────────────────────────────────────────────────────────
    match /earnings/{month} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── payouts ───────────────────────────────────────────────────────────────
    match /payouts/{payoutId} {
      // Contributors can read their own payout records
      allow read: if isContributor()
        && resource.data.contributorId == request.auth.uid;

      // Admin manages all payouts
      allow read, write: if isAdmin();
    }
  }
}
